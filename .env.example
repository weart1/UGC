# Ключ Runware: https://my.runware.ai → API Keys
RUNWARE_API_KEY=
# Пароль веб-панели (обязателен)
PANEL_PASSWORD=
# Необязательно: отдельный секрет для cookie сессии
SESSION_SECRET=
# Сколько задач (вариантов) генерировать одновременно
JOBS=2
# Домен для HTTPS через Caddy (docker compose --profile https up -d)
DOMAIN=
# Модель распознавания речи для примеров: tiny / base / small
WHISPER_MODEL=base
